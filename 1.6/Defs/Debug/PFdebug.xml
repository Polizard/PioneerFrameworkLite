  <!-- 飞船部署台：选取已保存的飞船设计部署到近地轨道 -->
  <ThingDef ParentName="BuildingBase">
    <defName>PF_ShipDeployer</defName>
    <label>飞船部署台</label>
    <description>选择已保存的飞船设计蓝图，部署到 500km 近地轨道，创建对应的 Group 和 Entity。</description>
    <thingClass>Building</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Ship/ShipSensorCluster</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(1.83, 0.5, 1.73)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <designationCategory>Power</designationCategory>
    <uiOrder>103</uiOrder>
    <costList>
      <Steel>30</Steel>
    </costList>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <comps>
      <li Class="PioneerFramework.CompProperties_DebugShipSpawner" />
    </comps>
  </ThingDef>
</Defs>