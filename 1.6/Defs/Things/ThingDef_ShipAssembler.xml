<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 部件设计台：创建和编辑部件模板 -->
  <ThingDef ParentName="BuildingBase">
    <defName>PF_PartTemplateDesigner</defName>
    <label>部件设计台</label>
    <description>用于设计飞船部件模板。可定义部件的形状、尺寸和类型专属参数，并保存为模板供装配台调用。</description>
    <thingClass>Building</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Ship/ShipSensorCluster</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(1.83, 0.5, 1.73)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <designationCategory>Power</designationCategory>
    <uiOrder>101</uiOrder>
    <costList>
      <Steel>30</Steel>
    </costList>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <comps>
      <li Class="PioneerFramework.CompProperties_PartTemplateDesigner" />
    </comps>
  </ThingDef>

  <!-- 飞船装配台：选取模板组装飞船 -->
  <ThingDef ParentName="BuildingBase">
    <defName>PF_ShipAssembler</defName>
    <label>飞船装配台</label>
    <description>用于从已保存的部件模板中选取型号，在 3D 空间中组装飞船并保存蓝图。</description>
    <thingClass>Building</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Ship/ShipSensorCluster</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(1.83, 0.5, 1.73)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <designationCategory>Power</designationCategory>
    <uiOrder>102</uiOrder>
    <costList>
      <Steel>50</Steel>
    </costList>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <comps>
      <li Class="PioneerFramework.CompProperties_ShipAssembler" />
    </comps>
  </ThingDef>
</Defs>
