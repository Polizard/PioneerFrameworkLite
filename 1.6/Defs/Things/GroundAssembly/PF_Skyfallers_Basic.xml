<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="DropPodLeaving">
    <defName>PF_Skyfaller_Leaving_Basic</defName>
    <label>basic rocket (leaving)</label>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/R7_Rocket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawRotated>false</drawRotated>
      <drawSize>(3, 3)</drawSize>
      <drawOffset>(0, 0, 1)</drawOffset>
    </graphicData>
    <comps>
      <li Class="PioneerFramework.Launch.CompProperties_RocketTangentGraphic" />
      <li Class="PioneerFramework.Launch.CompProperties_RocketExhaustTrail">
        <delayTicks>5</delayTicks>
        <centerToEngineBackset>1.0</centerToEngineBackset>
        <extendedCenterToEngineBackset>0.5</extendedCenterToEngineBackset>
        <exhaustFleck>Smoke</exhaustFleck>
        <smokeFleck>Smoke</smokeFleck>
        <onlyOnCurrentMap>true</onlyOnCurrentMap>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="DropPodIncoming">
    <defName>PF_Skyfaller_Incoming_Basic</defName>
    <label>basic rocket (incoming)</label>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/R7ReturnCarbin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawRotated>false</drawRotated>
      <drawSize>(3, 3)</drawSize>
      <drawOffset>(0, 0, 1)</drawOffset>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <ticksToImpactRange>
        <min>120</min>
        <max>120</max>
      </ticksToImpactRange>
      <speed>1.0</speed>
    </skyfaller>
    <comps>
      <li Class="PioneerFramework.Launch.CompProperties_RocketTangentGraphic" />
      <li Class="PioneerFramework.Launch.CompProperties_RocketLandingBurn">
        <burnDurationSeconds>0.5</burnDurationSeconds>
        <engineBackset>1.0</engineBackset>
        <flameFleck>Smoke</flameFleck>
        <smokePuffsPerTick>2</smokePuffsPerTick>
        <flameBurstsPerTick>1</flameBurstsPerTick>
        <smokeScale>1.5</smokeScale>
        <flameScale>1.0</flameScale>
        <onlyOnCurrentMap>true</onlyOnCurrentMap>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ActiveDropPod">
    <defName>PF_ActivePod_Basic</defName>
    <label>basic active pod</label>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/R7ReturnCarbin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2, 2)</drawSize>
    </graphicData>
  </ThingDef>

</Defs>
