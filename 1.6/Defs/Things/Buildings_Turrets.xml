<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>PF_Building_Turret_Cannon_Top</defName>
    <label>加农炮塔（上侧）</label>
    <description>向上单侧安装的加农炮塔。需绑定定位机方可索敌开火。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Security/TurretSniper_Top</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>4000</Mass>
      <Beauty>-8</Beauty>
      <WorkToBuild>1500</WorkToBuild>
    </statBases>
    <costList>
      <Steel>500</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <uiOrder>110</uiOrder>
    <comps>
      <li Class="PioneerFramework.CompProperties_MapTurret">
        <weaponDefName>PF_Weapon_ProjectileCannon</weaponDefName>
        <mountConfig>Top</mountConfig>
        <yOffset>25</yOffset>
      </li>
    </comps>
  </ThingDef>

