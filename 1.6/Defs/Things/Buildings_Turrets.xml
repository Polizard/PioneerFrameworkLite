<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>PF_Building_Turret_Cannon</defName>
    <label>加农炮塔</label>
    <description>整体式加农炮塔，360° 全方位射界，无死角。需绑定定位机方可索敌开火。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <!-- 底座贴图（原版重炮台地基）：炮头由 CompMapTurret.PostDraw 单独绘制（含朝向旋转），避免同一贴图画两遍 -->
      <texPath>Things/Building/Security/TurretHeavy_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3, 1.3)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>6000</Mass>
      <Beauty>-8</Beauty>
      <WorkToBuild>2200</WorkToBuild>
    </statBases>
    <costList>
      <Steel>800</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <uiOrder>110</uiOrder>
    <comps>
      <li Class="PioneerFramework.CompProperties_MapTurret">
        <weaponDefName>PF_Weapon_ProjectileCannon</weaponDefName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>PF_Building_Turret_Laser</defName>
    <label>激光炮塔</label>
    <description>整体式激光炮塔，光束即时命中、无需提前量。需绑定定位机方可索敌开火。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Security/TurretHeavy_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3, 1.3)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>6000</Mass>
      <Beauty>-8</Beauty>
      <WorkToBuild>2200</WorkToBuild>
    </statBases>
    <costList>
      <Steel>800</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <uiOrder>111</uiOrder>
    <comps>
      <li Class="PioneerFramework.CompProperties_MapTurret">
        <weaponDefName>PF_Weapon_Laser</weaponDefName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>PF_Building_TargetDesignator</defName>
    <label>目标定位机</label>
    <description>集中索敌的定位建筑。绑定炮塔后统一索敌并齐射。整体式炮塔 360° 无射界限制。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Ship/ShipSensorCluster</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>2000</Mass>
      <Beauty>-8</Beauty>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>300</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <uiOrder>113</uiOrder>
    <comps>
      <li Class="PioneerFramework.CompProperties_MapDesignator">
        <cooldownTicks>12</cooldownTicks>
        <scanIntervalTicks>32</scanIntervalTicks>
        <defaultMode>Auto</defaultMode>
      </li>
    </comps>
  </ThingDef>

</Defs>
