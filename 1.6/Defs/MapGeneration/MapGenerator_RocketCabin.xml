<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GenStepDef>
    <defName>GenStep_RocketCabinLayout</defName>
    <order>1100</order>
    <genStep Class="PioneerFramework.GenStep_RocketCabinLayout" />
  </GenStepDef>

  <MapGeneratorDef>
    <defName>PF_RocketCabinPocket</defName>
    <label>rocket cabin pocket</label>
    <defaultUnderGridTerrain>Concrete</defaultUnderGridTerrain>
    <disableCallAid>true</disableCallAid>
    <disableMapClippers>true</disableMapClippers>
    <genSteps>
      <li>PF_RoomShell</li>
      <li>GenStep_RocketCabinLayout</li>
    </genSteps>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <pocketMapProperties>
      <biome>Orbit</biome>
      <temperature>20</temperature>
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <preventPrisonerEscape>false</preventPrisonerEscape>
      <canLaunchGravship>false</canLaunchGravship>
    </pocketMapProperties>
    <renderWorld>true</renderWorld>
  </MapGeneratorDef>

</Defs>
