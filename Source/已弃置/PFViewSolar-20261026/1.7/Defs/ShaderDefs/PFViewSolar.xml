<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ShaderDef>
    <defName>PF_SolarPlasma</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_SolarBlit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_SolarPlasma.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <flipTextureST>false</flipTextureST>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_SolarBloom</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_SolarBlit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_SolarBloom.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <flipTextureST>false</flipTextureST>
      <textureWrapOverrides>
        <li><key>_MainTex</key><value>Clamp</value></li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_SolarComposite</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_SolarComposite.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_SolarComposite.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>1200</renderQueue>
      <flipTextureST>false</flipTextureST>
      <textureWrapOverrides>
        <li><key>_MainTex</key><value>Clamp</value></li>
        <li><key>_BloomTex</key><value>Clamp</value></li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
</Defs>
