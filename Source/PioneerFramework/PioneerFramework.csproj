<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PioneerFramework</RootNamespace>
    <AssemblyName>PioneerFrameworkLite</AssemblyName>
    <!--
      输出路径**按配置分离**（D2，2026-09-14）：
      · Release → `1.6/Assemblies/`（交付物；CI 用哈希校验它必须等于固定 SDK 的 Release 构建结果）；
      · Debug   → 项目内 `bin/`（被 .gitignore 忽略），**结构上不可能**碰到已提交的 DLL。
      旧写法两配置共用 `1.6/Assemblies/`：任何 Debug 构建（含 `dotnet test`）都会把已提交的 Release
      DLL 覆盖成 Debug 版 → 仓库被污染、CI 哈希断言变红、`1.6/Assemblies/*.pdb` 残留；
      当时只能靠"把重建 DLL 的步骤放到脚本最后"+ 文档警告来兜（2026-09-14 实测：一次普通 Debug
      构建就把已提交 DLL 的哈希改掉了）。
      要在**游戏内跑 Debug 版**（带行号的 .pdb）时显式指定输出目录即可（opt-in，不是默认）：
        dotnet build Source/PioneerFramework/PioneerFramework.csproj -c Debug -p:OutputPath=../../1.6/Assemblies/
    -->
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\..\1.6\Assemblies\</OutputPath>
    <OutputPath Condition="'$(Configuration)' != 'Release'">bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType Condition="'$(Configuration)' != 'Release'">portable</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PathMap>$(MSBuildProjectDirectory)=PioneerFramework</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>Libs\0Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>Libs\RimWorld\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>Libs\Unity\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>Libs\Unity\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 2026-10-10（烘焙落盘）：PNG 编解码 = ImageConversion.EncodeToPNG / LoadImage（扩展方法在这个模块里）。
         与其余 Unity 模块同源（都是从游戏 Managed/ 取出，Private=false 不随包分发）。 -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>Libs\Unity\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>Libs\Unity\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>Libs\Unity\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>Libs\Unity\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>Libs\Unity\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>Libs\Unity\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>


  <!--
    ══ D5（2026-09-26）：把"游戏里从不执行"的 16 个文件从**交付物**里摘掉 ══
    它们不是垃圾，是**验收层的数值参照**（`ODE/`，见 `ThirdParty/MechJebLib/README.md`）或纯测试用件，
    但**不该装进玩家手里的 DLL**。仓库**保留**它们，且两个测试工程各自用
    `<Compile Include="..\PioneerFramework\ThirdParty\MechJebLib\**\*.cs" />` **独立重编整份 MJ**
    ⇒ 移植面的 6201 条验收**照跑**。

    依据（已实测，不是估）：把移植面排除后，这些类型在**宿主侧零引用**
    （词尾边界的 \bType\b + 分隔符无关的过滤；移植面内唯一命中是 `BrentRoot.cs:173` 的一句注释）。
    ⚠ **名单若变动，必须重跑同一条核查并重建提交的 DLL**（`tools/rebuild-dll.ps1` + `tools/check-committed-dll.ps1`）。
  -->
  <ItemGroup>
    <Compile Remove="ThirdParty\MechJebLib\ODE\**\*.cs" />
    <Compile Remove="ThirdParty\MechJebLib\Interpolants\**\*.cs" />
    <Compile Remove="ThirdParty\MechJebLib\TwoBody\Farnocchia.cs" />
    <Compile Remove="ThirdParty\MechJebLib\Rootfinding\Bisection.cs" />
    <Compile Remove="ThirdParty\MechJebLib\Rootfinding\Newton.cs" />
    <Compile Remove="ThirdParty\MechJebLib\Primitives\Vec.cs" />
    <Compile Remove="ThirdParty\MechJebLib\Primitives\VecOps.cs" />
    <Compile Remove="ThirdParty\MechJebLib\Utils\ObjectPool.cs" />
  </ItemGroup>

</Project>
