# .editorconfig —— 1.7 主线（Source/ 下所有工程）的规范地板（2026-10-14 落地，N1）
#
# 原则（沿用总纲 N1/D3）：
#   ① **先描述现状、再逐类收紧**——本文件第一版以"与现有代码一致"为准，不制造无谓重排；
#   ② 与上游/RimWorld 惯例冲突的分析器规则，**在这里写明理由后关掉**（这不是藏债，是宣告家规）；
#   ③ 真实技术债的告警**保持可见**（如 CA1305），由 N2/N3 的"顺手条"在改动文件时逐处清。
#
# 覆盖范围：只在 Source/ 下（legacy/1.6/Source 不在内；1.6 线零写入）。

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.{csproj,props,targets,xml,yml,yaml,json}]
indent_size = 2

[*.cs]
# ── 语言与风格（与现有代码一致；不强制重排）──
csharp_style_namespace_declarations = block_scoped:silent
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_style_expression_bodied_methods = false:silent
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_readonly_field = true:suggestion

# ── 属于"家规"的规则：写明理由后关闭（不是藏债）──

# CA1051（不要声明可见实例字段）：RimWorld Def/CompProperties 的**绑定语义就是公开字段**
#（XML <字段名> 直接绑到 C# 字段）；上游模组惯例亦然。改成属性会同时破坏 Def 绑定与上游一致性。
dotnet_diagnostic.CA1051.severity = none

# CA1707（标识符不许带下划线）：本仓（与上游 MechJebLib/RimWorld）惯例 = 私有字段 `_name`。
# 这是刻意的风格，不是事故。
dotnet_diagnostic.CA1707.severity = none

# CA2211（非常量公开静态字段）：RimWorld API 本身的形态（大量 public static 可由补丁/调试读取），
# 且本仓多处静态字段是"运行时开关/缓存"（如调试开关），刻意公开。
dotnet_diagnostic.CA2211.severity = none

# ── 说明：以下规则**保持开启**（真实债，逐类清；计数基线见台账）──
#   CA1805（显式默认初始化）/ CA1834 / CA1825 / CA2249 / CA1866 / CA1310 → N2 顺手条（下一批）
#   CA1305 已于 N2①（2026-10-14）清到残 17 处（留档在总纲 §N2：net48 链接文件不可用 provider 重载 /
#   动态格式串 / 参数非纯表达式的索引重排 / 无参 ToString 若干 —— 行为与默认同口径，仅为可见债）

# ── 语句/算法现代化批（2026-10-14，用户点名）：把 IDE 系列**临时升为 warning** 让编译器给出精确位置，
#    **批已完成（2026-10-15）：规则降回 suggestion**；残量（IDE0305 的 18 处 ToList/ToArray→`[.. x]`、
#    IDE0301 的 3 处 System.Array.Empty 全限定形式、IDE0090 的 4 处定位未解）逐条判过不接/留档（见总纲）。
#    ⚠ 必须排在 ThirdParty 段**之前**：.editorconfig 后段覆盖前段，移植面的 `none` 要靠"更晚"生效。
dotnet_diagnostic.IDE0090.severity = suggestion   # 目标类型 new：`new List<X>()` → `new()`
dotnet_diagnostic.IDE0300.severity = suggestion   # 集合表达式：`new List<X> { … }` → `[…]`
dotnet_diagnostic.IDE0301.severity = suggestion   # 空集合：`Array.Empty<X>()` → `[]`
dotnet_diagnostic.IDE0305.severity = suggestion   # `new X[] { … }` → `[…]`
dotnet_diagnostic.IDE0063.severity = suggestion   # `using (…) { }` → `using var`

# ── MJ 移植面（PioneerFramework/ThirdParty/MechJebLib）：**保真子树**，不施加本库风格/正确性分析器 ──
# 理由：这棵子树的纪律是"与上游**可重合并**"（README 的 T-A/T-B/T-C 分档），逐字保真优先于本库风格；
#       对它做 CA1834/CA2201/CA1708… 属于"改上游代码"，收益为零、只添合并摩擦。
[PioneerFramework/ThirdParty/**/*.cs]
dotnet_diagnostic.CA1036.severity = none
dotnet_diagnostic.CA1067.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1708.severity = none
dotnet_diagnostic.CA1710.severity = none
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA1834.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.CA2231.severity = none
# 语句现代化批同款豁免（IDE 系列在移植面同样不适用：保真/可重合并）
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_diagnostic.IDE0063.severity = none

# ── 家规（第二批，2026-10-14；均**判过不接**，理由随条目）──
[*.cs]
# CA1822（成员可静态化）：纯风格收益、改动面大（74 处 + 全调用点），且本库多成员刻意保持实例形态
#（Unity/Def 对称面、将来多实例留面）⇒ 不强推；IDE 里仍以 suggestion 可见。
dotnet_diagnostic.CA1822.severity = suggestion

# CA2201（保留异常类型）/ CA1708（仅大小写不同的标识符）/ CA1711/CA1716/CA1725（命名）：本库诊断面
# 与 API 形态刻意为之（DevMode 验收路径抛泛型异常；Def/移植面命名），逐点判过不接。
dotnet_diagnostic.CA2201.severity = suggestion
dotnet_diagnostic.CA1708.severity = suggestion
dotnet_diagnostic.CA1711.severity = suggestion
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1725.severity = suggestion

# CA1001（持有可释放字段的类型应实现 IDisposable）：RimWorld `Window`/`ITab` 生命周期由
# `OnClose`/`PreClose` 管理（引擎不调 Dispose）、`RenderTexture` 在收起时显式 Release ⇒ 不是债。
dotnet_diagnostic.CA1001.severity = suggestion
