<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 2026-10-14（主线切 net10）：与主工程同步。 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PioneerFramework\PioneerFramework.csproj" />
  </ItemGroup>

  <!-- 2026-10-14：引用换游戏根三件 + Harmony 3（同主工程；路径见 Source/Directory.Build.props） -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Rw17Dir)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(Rw17Dir)\UnityStubs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(Rw17Dir)\Waylith.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Harmony17Dir)\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Shaders\*.shader" Link="Shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\1.6\Defs\**\*.xml" Link="Defs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\1.6\Patches\**\*.xml" Link="Patches\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PioneerFramework.csproj" Link="Source\PioneerFramework\PioneerFramework.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\Base\Game\RuntimePlanetLayerService.cs" Link="Source\PioneerFramework\Base\Game\RuntimePlanetLayerService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\WorldGenStep\WorldGenStep_MoonTiles.cs" Link="Source\PioneerFramework\WorldGenStep\WorldGenStep_MoonTiles.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\MapGeneration\MoonSurfaceMapGeneration.cs" Link="Source\PioneerFramework\MapGeneration\MoonSurfaceMapGeneration.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\MainTabWindow_PFView.cs" Link="Source\PioneerFramework\PFView\MainTabWindow_PFView.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\PFViewToonShader.cs" Link="Source\PioneerFramework\PFView\PFViewToonShader.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\MainTabWindow_PFView.Render.cs" Link="Source\PioneerFramework\PFView\MainTabWindow_PFView.Render.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\MainTabWindow_PFView.Scene.cs" Link="Source\PioneerFramework\PFView\MainTabWindow_PFView.Scene.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\MainTabWindow_PFView.GUI.cs" Link="Source\PioneerFramework\PFView\MainTabWindow_PFView.GUI.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- D-1（2026-10-11）：画船代码从 Scene/MapRelief 抽到 ShipModelRenderer ⇒ 扫描面一并覆盖（同 V-0 拆文件的连坐纪律：只许加覆盖） -->
    <None Include="..\PioneerFramework\PFView\ShipModelRenderer.cs" Link="Source\PioneerFramework\PFView\ShipModelRenderer.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\ToonOutline\PFViewOutlineContracts.cs" Link="Source\PioneerFramework\PFView\ToonOutline\PFViewOutlineContracts.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PioneerFramework\PFView\ToonOutline\PFViewOutlineAssetBundleProvider.cs" Link="Source\PioneerFramework\PFView\ToonOutline\PFViewOutlineAssetBundleProvider.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
