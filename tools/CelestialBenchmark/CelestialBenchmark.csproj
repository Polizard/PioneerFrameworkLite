<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PioneerFramework.CelestialBenchmark</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyGameReferences>true</CopyGameReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="../../Source/PioneerFramework/Libs/TestRuntime/*.dll"><Private>true</Private></Reference>
    <ProjectReference Include="../../Source/PioneerFramework/PioneerFramework.csproj"
                      AdditionalProperties="OutputPath=$(MSBuildThisFileDirectory)..\..\Source\PioneerFramework\bin\CelestialBenchmark\$(Configuration)\" />
    <Compile Include="../../Source/TestSupport/Celestial/CelestialBenchFactory.cs" Link="Support/CelestialBenchFactory.cs" />
    <Compile Include="../../Source/TestSupport/Celestial/CelestialShipBenchScope.cs" Link="Support/CelestialShipBenchScope.cs" />
  </ItemGroup>
  <Import Project="../../Source/GameReferences.props" />
</Project>
