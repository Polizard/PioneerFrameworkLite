    <ThingDef ParentName="ResourceBase">
    <defName>DMSNF_SpaceSurveillancePayload</defName>
    <label>空间目标监视载荷</label>
    <description>用于探测轨道天体的任务载荷，装载到运载火箭上来发射到轨道。</description>
    <graphicData>
      <texPath>Things/Resource/Payloads/SpaceSurveillancePayload</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>5</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <MarketValue>712</MarketValue>
      <Mass>350</Mass>
      <Flammability>0.0</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <intricate>true</intricate>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

