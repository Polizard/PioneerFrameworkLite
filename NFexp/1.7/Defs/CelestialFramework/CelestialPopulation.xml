<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PioneerFramework.Celestial.CelestialPopulationPolicyDef>
    <defName>PF_DefaultCelestialPopulation</defName>
    <label>默认恒星系生成</label>
    <minimumPlanets>4</minimumPlanets><maximumPlanets>8</maximumPlanets>
    <minimumDwarfs>1</minimumDwarfs><maximumDwarfs>4</maximumDwarfs>
    <attemptsPerSlot>32</attemptsPerSlot>
    <!-- Relative to the authored home orbit. This factor does not change the light-source capability. -->
    <referenceIrradiance>1</referenceIrradiance>
    <minimumOrbitSeparation>0.06</minimumOrbitSeparation>
    <hillFraction>0.35</hillFraction>
    <satelliteMassFraction>0.05</satelliteMassFraction>
    <distanceBands>
      <li><minimum>0.15</minimum><maximum>0.5</maximum><planetWeight>0.6</planetWeight><dwarfWeight>0</dwarfWeight></li>
      <li><minimum>0.5</minimum><maximum>0.95</maximum><planetWeight>1</planetWeight><dwarfWeight>0</dwarfWeight></li>
      <li><minimum>0.95</minimum><maximum>1.4</maximum><planetWeight>1</planetWeight><dwarfWeight>0.05</dwarfWeight></li>
      <li><minimum>1.4</minimum><maximum>3</maximum><planetWeight>1</planetWeight><dwarfWeight>0.2</dwarfWeight></li>
      <li><minimum>3</minimum><maximum>10</maximum><planetWeight>1</planetWeight><dwarfWeight>0.7</dwarfWeight></li>
      <li><minimum>10</minimum><maximum>30</maximum><planetWeight>1</planetWeight><dwarfWeight>1</dwarfWeight></li>
      <li><minimum>30</minimum><maximum>60</maximum><planetWeight>0.25</planetWeight><dwarfWeight>0.7</dwarfWeight></li>
    </distanceBands>
    <bodyRules>
      <li>
        <body>PF_BarrenPlanet</body><role>Planet</role><weight>3</weight><maximumDistance>4</maximumDistance>
        <minimumRadiusMeters>900000</minimumRadiusMeters><maximumRadiusMeters>3900000</maximumRadiusMeters>
        <minimumDensity>3500</minimumDensity><maximumDensity>6100</maximumDensity>
        <moonCountWeights><li>6</li><li>3</li><li>1</li></moonCountWeights>
      </li>
      <li>
        <body>PF_TemperatePlanet</body><role>Planet</role><weight>2</weight><minimumDistance>0.7</minimumDistance><maximumDistance>2.35</maximumDistance>
        <minimumRadiusMeters>3200000</minimumRadiusMeters><maximumRadiusMeters>5800000</maximumRadiusMeters>
        <minimumDensity>4100</minimumDensity><maximumDensity>6600</maximumDensity>
        <moonCountWeights><li>2</li><li>6</li><li>2</li></moonCountWeights>
      </li>
      <li>
        <body>PF_GreenhousePlanet</body><role>Planet</role><weight>2</weight><maximumDistance>1.7</maximumDistance>
        <minimumRadiusMeters>2800000</minimumRadiusMeters><maximumRadiusMeters>4900000</maximumRadiusMeters>
        <minimumDensity>4300</minimumDensity><maximumDensity>6400</maximumDensity>
        <minimumSpinSeconds>120000</minimumSpinSeconds><maximumSpinSeconds>1200000</maximumSpinSeconds>
        <moonCountWeights><li>8</li><li>2</li></moonCountWeights>
      </li>
      <li>
        <body>PF_FrozenPlanet</body><role>Planet</role><weight>2</weight><minimumDistance>1.65</minimumDistance>
        <minimumRadiusMeters>1000000</minimumRadiusMeters><maximumRadiusMeters>3600000</maximumRadiusMeters>
        <minimumDensity>1500</minimumDensity><maximumDensity>3800</maximumDensity>
        <moonCountWeights><li>2</li><li>6</li><li>2</li></moonCountWeights>
      </li>
      <li>
        <body>PF_GasGiant</body><role>Planet</role><weight>6</weight><minimumDistance>3</minimumDistance><maximumDistance>30</maximumDistance>
        <minimumRadiusMeters>7500000</minimumRadiusMeters><maximumRadiusMeters>13500000</maximumRadiusMeters>
        <minimumDensity>850</minimumDensity><maximumDensity>2200</maximumDensity>
        <minimumSpinSeconds>25000</minimumSpinSeconds><maximumSpinSeconds>68000</maximumSpinSeconds>
        <moonCountWeights><li>0</li><li>1</li><li>3</li><li>4</li><li>2</li></moonCountWeights>
      </li>
      <li>
        <body>PF_IceGiant</body><role>Planet</role><weight>6</weight><minimumDistance>6</minimumDistance><maximumDistance>35</maximumDistance>
        <minimumRadiusMeters>5300000</minimumRadiusMeters><maximumRadiusMeters>9000000</maximumRadiusMeters>
        <minimumDensity>1400</minimumDensity><maximumDensity>2700</maximumDensity>
        <minimumSpinSeconds>35000</minimumSpinSeconds><maximumSpinSeconds>85000</maximumSpinSeconds>
        <moonCountWeights><li>0</li><li>2</li><li>4</li><li>3</li><li>1</li></moonCountWeights>
      </li>
      <li>
        <body>PF_BarrenPlanet</body><role>DwarfPlanet</role><weight>2</weight><maximumDistance>6</maximumDistance>
        <minimumRadiusMeters>190000</minimumRadiusMeters><maximumRadiusMeters>900000</maximumRadiusMeters>
        <minimumDensity>2700</minimumDensity><maximumDensity>4400</maximumDensity>
        <moonCountWeights><li>9</li><li>1</li></moonCountWeights>
      </li>
      <li>
        <body>PF_FrozenPlanet</body><role>DwarfPlanet</role><weight>4</weight><minimumDistance>1.4</minimumDistance>
        <minimumRadiusMeters>190000</minimumRadiusMeters><maximumRadiusMeters>1050000</maximumRadiusMeters>
        <minimumDensity>1200</minimumDensity><maximumDensity>3000</maximumDensity>
        <moonCountWeights><li>7</li><li>3</li></moonCountWeights>
      </li>
      <li>
        <body>PF_BarrenPlanet</body><role>Moon</role><weight>2</weight>
        <minimumRadiusMeters>65000</minimumRadiusMeters><maximumRadiusMeters>780000</maximumRadiusMeters>
        <minimumDensity>2600</minimumDensity><maximumDensity>4400</maximumDensity>
      </li>
      <li>
        <body>PF_FrozenPlanet</body><role>Moon</role><weight>5</weight><minimumDistance>1.4</minimumDistance>
        <minimumRadiusMeters>65000</minimumRadiusMeters><maximumRadiusMeters>980000</maximumRadiusMeters>
        <minimumDensity>1100</minimumDensity><maximumDensity>3100</maximumDensity>
      </li>
    </bodyRules>
  </PioneerFramework.Celestial.CelestialPopulationPolicyDef>
</Defs>
