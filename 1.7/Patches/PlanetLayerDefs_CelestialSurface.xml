<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 实例保存头在根层构造前确定；世界生成统一由保存的 profile 分派。
       自有层继承原天体可见性规则。原版步骤由 profile 按原顺序和种子调用一次。 -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/PlanetLayerDef[defName="Surface"]/layerType</xpath>
        <value><layerType>PioneerFramework.Celestial.CelestialSurfaceLayer</layerType></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/PlanetLayerDef[defName="Surface"]/worldGenSteps</xpath>
        <value><worldGenSteps><li>PF_CelestialTiles</li></worldGenSteps></value>
      </li>
    </operations>
  </Operation>
</Patch>
