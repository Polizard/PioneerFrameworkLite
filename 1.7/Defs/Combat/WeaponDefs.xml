<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PioneerFramework.Combat.WeaponDef>
    <defName>PF_Weapon_ProjectileCannon</defName>
    <label>加农炮</label>
    <description>标准的太空加农炮，发射高速射弹（默认武器部件引用）。</description>
    <weaponType>Projectile</weaponType>
    <damagePerShot>40</damagePerShot>
    <armorPenetration>10</armorPenetration>
    <fireRate>1</fireRate>
    <maxRange>3000000</maxRange>
    <minRange>50</minRange>
    <orbitalEngageRange>300000</orbitalEngageRange>
    <cooldownTicks>12</cooldownTicks>
    <overheatThreshold>10</overheatThreshold>
    <overheatCooldownTicks>300</overheatCooldownTicks>
    <mountSize>(2, 1, 2)</mountSize>
    <turret>true</turret>
    <turretRotationSpeed>30</turretRotationSpeed>
    <trackingArc>360</trackingArc>
    <projectileSpeed>5000</projectileSpeed>
    <projectileMass>0.5</projectileMass>
    <affectedByGravity>false</affectedByGravity>
    <projectileLifetime>600</projectileLifetime>
  </PioneerFramework.Combat.WeaponDef>

  <PioneerFramework.Combat.WeaponDef>
    <defName>PF_Weapon_Laser</defName>
    <label>激光炮</label>
    <description>快速射击的定向能武器，光束即时命中、无需提前量，精度高但单发伤害低。</description>
    <weaponType>Ray</weaponType>
    <damagePerShot>10</damagePerShot>
    <armorPenetration>3</armorPenetration>
    <fireRate>2.0</fireRate>
    <maxRange>50000</maxRange>
    <minRange>10</minRange>
    <orbitalEngageRange>50000</orbitalEngageRange>
    <accuracyRadius>0.5</accuracyRadius>
    <cooldownTicks>30</cooldownTicks>
    <overheatThreshold>20</overheatThreshold>
    <overheatCooldownTicks>200</overheatCooldownTicks>
    <turret>true</turret>
    <turretRotationSpeed>60</turretRotationSpeed>
    <trackingArc>180</trackingArc>
    <referenceDistance>100</referenceDistance>
    <inverseSquareFalloff>true</inverseSquareFalloff>
    <rayMaxLength>50000</rayMaxLength>
    <beamVisualColor>(1, 0.3, 0.1)</beamVisualColor>
  </PioneerFramework.Combat.WeaponDef>

  <PioneerFramework.Combat.WeaponDef>
    <defName>PF_Weapon_MissileLauncher</defName>
    <label>导弹发射器</label>
    <description>发射制导导弹，可绕过障碍物。</description>
    <weaponType>Missile</weaponType>
    <damagePerShot>50</damagePerShot>
    <armorPenetration>15</armorPenetration>
    <fireRate>0.2</fireRate>
    <maxRange>10000</maxRange>
    <minRange>100</minRange>
    <cooldownTicks>300</cooldownTicks>
    <missileCount>1</missileCount>
    <missileSpeed>150</missileSpeed>
    <terminalSpeed>800</terminalSpeed>
    <missileFuel>2000</missileFuel>
    <engageDistance>50</engageDistance>
    <requiresDirectPath>false</requiresDirectPath>
    <!-- 弹体/弹头定义（K2）：MissileDef 独立承载 -->
    <missileDefName>PF_Missile_Standard</missileDefName>
  </PioneerFramework.Combat.WeaponDef>

  <!-- 巡航测试武器：弹体 = PF_Missile_TestCruise（homing 500m，场景现场换装用，不动正式武器 Def） -->
  <PioneerFramework.Combat.WeaponDef>
    <defName>PF_Weapon_MissileLauncher_CruiseTest</defName>
    <label>导弹发射器（巡航测试）</label>
    <description>巡航测试专用：弹体 PF_Missile_TestCruise。</description>
    <weaponType>Missile</weaponType>
    <damagePerShot>50</damagePerShot>
    <armorPenetration>15</armorPenetration>
    <fireRate>0.2</fireRate>
    <maxRange>10000</maxRange>
    <minRange>100</minRange>
    <cooldownTicks>300</cooldownTicks>
    <missileCount>1</missileCount>
    <missileSpeed>150</missileSpeed>
    <terminalSpeed>800</terminalSpeed>
    <missileFuel>2000</missileFuel>
    <engageDistance>50</engageDistance>
    <requiresDirectPath>false</requiresDirectPath>
    <missileDefName>PF_Missile_TestCruise</missileDefName>
  </PioneerFramework.Combat.WeaponDef>

  <PioneerFramework.Combat.WeaponDef>
    <defName>PF_Weapon_DroneLauncher</defName>
    <label>无人机发射器</label>
    <description>发射武装无人机，进入终末阶段后自动开火。</description>
    <weaponType>Drone</weaponType>
    <fireRate>0.1</fireRate>
    <maxRange>15000</maxRange>
    <minRange>200</minRange>
    <cooldownTicks>600</cooldownTicks>
    <missileCount>3</missileCount>
    <missileSpeed>200</missileSpeed>
    <terminalSpeed>500</terminalSpeed>
    <missileFuel>120</missileFuel>
    <engageDistance>100</engageDistance>
    <isWeaponized>true</isWeaponized>
    <droneWeaponDef>PF_Weapon_DroneGun</droneWeaponDef>
    <weaponsEngageRange>20</weaponsEngageRange>
  </PioneerFramework.Combat.WeaponDef>

  <PioneerFramework.Combat.WeaponDef>
    <defName>PF_Weapon_DroneGun</defName>
    <label>无人机机炮</label>
    <description>无人机携带的小型机炮。</description>
    <weaponType>Projectile</weaponType>
    <damagePerShot>5</damagePerShot>
    <armorPenetration>2</armorPenetration>
    <fireRate>3.0</fireRate>
    <maxRange>200</maxRange>
    <minRange>5</minRange>
    <cooldownTicks>20</cooldownTicks>
    <projectileSpeed>500</projectileSpeed>
    <projectileLifetime>5</projectileLifetime>
  </PioneerFramework.Combat.WeaponDef>
</Defs>