<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PioneerFramework.ProjectileVisuals.ProjectileVisualDef>
    <defName>PF_Visual_KineticAP</defName>
    <flight>
      <li>
        <kind>Streak</kind>
        <color>(0.86,0.94,1,0.92)</color>
        <widthPixels>1.5</widthPixels>
        <maxLengthPixels>48</maxLengthPixels>
        <sampleSeconds>0.035</sampleSeconds>
      </li>
    </flight>
    <onContact>
      <li>
        <kind>Sparks</kind>
        <color>(1,0.82,0.55,0.9)</color>
        <durationSeconds>0.13</durationSeconds>
        <maxRadiusPixels>6</maxRadiusPixels>
      </li>
    </onContact>
  </PioneerFramework.ProjectileVisuals.ProjectileVisualDef>
  <PioneerFramework.ProjectileVisuals.ProjectileVisualDef>
    <defName>PF_Visual_KineticHE</defName>
    <flight>
      <li>
        <kind>Streak</kind>
        <color>(1,0.66,0.35,0.92)</color>
        <widthPixels>2</widthPixels>
        <maxLengthPixels>42</maxLengthPixels>
        <sampleSeconds>0.035</sampleSeconds>
      </li>
    </flight>
    <onDetonation>
      <li>
        <kind>Burst</kind>
        <color>(1,0.57,0.24,0.95)</color>
        <durationSeconds>0.25</durationSeconds>
        <maxRadiusPixels>12</maxRadiusPixels>
      </li>
    </onDetonation>
  </PioneerFramework.ProjectileVisuals.ProjectileVisualDef>
  <PioneerFramework.ProjectileVisuals.ProjectileVisualDef>
    <defName>PF_Visual_LaserContact</defName>
    <onContact>
      <li>
        <kind>Flash</kind>
        <color>(1,0.94,0.82,1)</color>
        <durationSeconds>0.10</durationSeconds>
        <maxRadiusPixels>4</maxRadiusPixels>
      </li>
    </onContact>
  </PioneerFramework.ProjectileVisuals.ProjectileVisualDef>
</Defs>
