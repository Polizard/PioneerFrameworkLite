<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ShaderDef>
    <defName>PF_StellarSurface</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolume.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_StellarHalo</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolume.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <!-- 2026-10-28 P2 optional fast renderer (analytic photosphere + thin corona shell).
       Default rendering still uses PF_StellarSurface/PF_StellarHalo above; these two defs are
       selected only when the player enables "useFastStellarRenderer" in Mod settings. -->
  <ShaderDef>
    <defName>PF_StellarSurfaceFast</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolumeFast.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_StellarHaloFast</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolumeFast.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <!-- 2026-11-07 S3-a optional-but-default region-skipping integration (PFViewStellarProbe.S3AEnabled).
       Same pipeline states as the legacy pair; fragment shader keeps the approved sampling grid in
       the dense region and only skips/coarse-integrates the r > 1.42 outer tail. -->
  <ShaderDef>
    <defName>PF_StellarSurfaceS3A</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolumeS3A.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_StellarHaloS3A</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolumeS3A.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <!-- 2026-11-20 S3-b experimental star-only half-resolution offscreen (PFViewStellarProbe.S3BEnabled,
       default false). These composite the half-res star RT back into the main 1.0x RT; depth is the
       analytic approximation described in PF_StellarComposite.frag.glsl. -->
  <ShaderDef>
    <defName>PF_StellarSurfaceComposite</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarComposite.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_StellarHaloComposite</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarComposite.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>
</Defs>
