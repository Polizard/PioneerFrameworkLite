<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ShaderDef>
    <defName>PF_StellarSurface</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolume.frag.glsl</fragmentShaderFileName>
      <blendMode>Opaque</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2000</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_StellarHalo</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_StellarVolume.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_StellarVolume.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>Front</cullMode>
      <renderQueue>2900</renderQueue>
    </shaderProgram>
  </ShaderDef>
</Defs>
