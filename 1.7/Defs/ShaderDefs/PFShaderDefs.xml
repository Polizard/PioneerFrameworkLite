<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- PioneerFramework 自写 shader（2026-10-13，1.7 迁移 P2-c）。
       背景：1.7 换引擎后 `Shader.Find("Standard")` = null（引擎注册表无 Standard），
       PFView 主材质改由本 shader 承担；GLSL 在载入文件夹 `1.7/Shaders/` 下（引擎自动收集，
       见 `Verse.ShaderDefRegistry.RegisterShaderDirectories`），运行时支持热重载。
       约束（引擎现况）：uniform ≤512B、storage ≤8、无关键字变体；混合/队列按引擎映射。 -->
  <ShaderDef>
    <defName>PFLit</defName>
    <shaderProgram>
      <vertexShaderFileName>PFLit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PFLit.frag.glsl</fragmentShaderFileName>
      <depthWrite>true</depthWrite>
      <renderQueue>2000</renderQueue>
      <!-- 2026-10-14：**改为 true（= 引擎默认）**。上一稿抄地图类 shader 写了 false——错：
           地图 shader 自算 UV 不需要 ST 修正；我们走 `_MainTex_ST` 采样（Unity 贴图底朝上 ⇒ 需要 V 翻正），
           false 会把这个翻正关掉 ⇒ 补丁在球面上呈"左右反"（本模 V 轴=东西向），且 6×3 平铺也丢失。
           证据链：`Waylith/Rendering/MaterialBindingResolver.ResolveTextureST`（flipV ⇒ y=1-y, w=-w）。 -->
      <flipTextureST>true</flipTextureST>
    </shaderProgram>
  </ShaderDef>

  <!-- P2-e（2026-10-15）：三渲二 + 描边，保真移植自 1.6 `Shaders/PF_Toon.shader`（V-1.4 四阶量化）。
       1.6 = ShaderLab 单材质双 pass 经 AssetBundle 交付；1.7 一个 ShaderDef 只有**一个 pass**、
       且 bundle 只认 Vulkan/SPIR-V ⇒ 描边独立成 `PF_ToonOutline`（inverted hull：顶点沿法线挤出 +
       `cullMode=Front` 只画背面），由 C# 逐部件补第二笔 draw（先描边后主体，两者 depthWrite 均开）。 -->
  <ShaderDef>
    <defName>PF_Toon</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_Toon.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_Toon.frag.glsl</fragmentShaderFileName>
      <depthWrite>true</depthWrite>
      <renderQueue>2000</renderQueue>
      <flipTextureST>true</flipTextureST>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>PF_ToonOutline</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_ToonOutline.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_ToonOutline.frag.glsl</fragmentShaderFileName>
      <depthWrite>true</depthWrite>
      <cullMode>Front</cullMode>
      <!-- 队列先于主体（1998 < 2000）：壳先落笔、主体随后按深度覆盖，轮廓环留在剪影外侧。
           C# 也按"先描边后主体"提交；此处队列值是与引擎排序一致性的双保险。 -->
      <renderQueue>1998</renderQueue>
      <flipTextureST>true</flipTextureST>
    </shaderProgram>
  </ShaderDef>

  <!-- ════════════════════════════════════════════════════════════════════
       环世界「电影感」视觉升级（2026-10-17，recon-render/task-5；契约 = `.zcode/ringworld-visual/IMPL.md` §2）。
       · PF_RingLit  = 环主体受光（居住面/外壳/端盖）；不透明、写深度、单面（Back）。
       · PF_RingOrnament = 装饰实体专用方向受光；复用主体顶点阶段。
         C# 侧（Lead 的 RingWorldMaterials）显式 material.renderQueue=3500。
       · PF_RingGlow = 加性辉光（rim / ribbon 大气薄带 / sprite 灯晕）；不写深度、双面、queue 3550。
       · GLSL 在 1.7/Shaders/ 下（引擎 ShaderDefRegistry 自动收集，无需 AssetBundle）。
       · 两 shader 都不声明 FragmentUniforms（set=0,binding=1 对 Mod shader 是否自动绑定未验证）；
         太阳方向/相机位置/时间走 material uniform（C# RingWorldVisualState 每帧写 _RingSunDir/_RingCameraPos/_RingTime）。
       · flipTextureST 显式 false（Lead 裁决 2026-10-17）：raw UV 采样，PNG 顶部 = 环 +Y 侧。
         反编译证据：`Waylith.Rendering.ShaderProgramDefinition.flipTextureST` 的 C# 字段初值是 true
         （`.zcode/tmp/render-inspection/WL_Waylith_Rendering_ShaderProgramDefinition.cs:13`），
         XML 缺省≠false ⇒ 必须显式写，不能省略。
       ════════════════════════════════════════════════════════════════════ -->
  <ShaderDef>
    <defName>PF_RingLit</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_RingLit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_RingLit.frag.glsl</fragmentShaderFileName>
      <depthWrite>true</depthWrite>
      <cullMode>Back</cullMode>
      <flipTextureST>false</flipTextureST>
    </shaderProgram>
  </ShaderDef>

  <!-- 装饰实体独立方向受光，主体昼夜混色保持原有口径。 -->
  <ShaderDef>
    <defName>PF_RingOrnament</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_RingLit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_RingOrnament.frag.glsl</fragmentShaderFileName>
      <depthWrite>true</depthWrite>
      <cullMode>Back</cullMode>
      <flipTextureST>false</flipTextureST>
    </shaderProgram>
  </ShaderDef>

  <!-- 末端实体灯头：复用辉光公式的 mode 4，不透明写深度，六个面均直接发光。 -->
  <ShaderDef>
    <defName>PF_RingTerminal</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_RingGlow.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_RingGlow.frag.glsl</fragmentShaderFileName>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <cullMode>Back</cullMode>
      <renderQueue>3500</renderQueue>
      <flipTextureST>false</flipTextureST>
    </shaderProgram>
  </ShaderDef>

  <ShaderDef>
    <defName>PF_RingGlow</defName>
    <shaderProgram>
      <vertexShaderFileName>PF_RingGlow.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_RingGlow.frag.glsl</fragmentShaderFileName>
      <blendMode>Additive</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3550</renderQueue>
      <flipTextureST>false</flipTextureST>
    </shaderProgram>
  </ShaderDef>
</Defs>
