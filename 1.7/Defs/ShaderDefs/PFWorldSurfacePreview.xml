<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ShaderDef>
    <defName>PF_WorldSurfacePreview</defName>
    <shaderProgram>
      <vertexShaderFileName>PFLit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_WorldSurfacePreview.frag.glsl</fragmentShaderFileName>
      <depthTest>true</depthTest>
      <depthWrite>true</depthWrite>
      <flipTextureST>true</flipTextureST>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>PF_WorldSurfacePreviewFade</defName>
    <shaderProgram>
      <vertexShaderFileName>PFLit.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PF_WorldSurfacePreview.frag.glsl</fragmentShaderFileName>
      <blendMode>Alpha</blendMode>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <!-- Native hills, rivers and roads occupy queues 3510–3540. -->
      <renderQueue>3560</renderQueue>
      <flipTextureST>true</flipTextureST>
    </shaderProgram>
  </ShaderDef>
</Defs>
