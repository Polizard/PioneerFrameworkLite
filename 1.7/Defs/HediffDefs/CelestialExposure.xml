<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef Name="PF_CelestialExposureBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad><initialSeverity>0.001</initialSeverity><lethalSeverity>1</lethalSeverity>
    <comps><li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-0.1</severityPerDay></li></comps>
    <stages>
      <li><minSeverity>0.1</minSeverity><capMods><li><capacity>Consciousness</capacity><offset>-0.1</offset></li></capMods></li>
      <li><minSeverity>0.5</minSeverity><capMods><li><capacity>Consciousness</capacity><offset>-0.5</offset></li></capMods></li>
      <li><minSeverity>0.8</minSeverity><capMods><li><capacity>Consciousness</capacity><offset>-0.8</offset></li></capMods></li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="PF_CelestialExposureBase"><defName>PF_CelestialHypoxia</defName><label>缺氧</label><description>氧分压不足造成的生存暴露。需要供氧；普通防毒能力无法提供氧气。</description></HediffDef>
  <HediffDef ParentName="PF_CelestialExposureBase"><defName>PF_CelestialPressureStress</defName><label>气压应激</label><description>气压超出适应范围造成的生存暴露。真空防护只适用于低压，高压需要独立防护。</description></HediffDef>
  <HediffDef ParentName="PF_CelestialExposureBase"><defName>PF_CelestialRadiationExposure</defName><label>环境辐射暴露</label><description>行星环境辐射造成的简化累积损伤。需要专门辐射防护，供氧和毒气过滤不抵消辐射。</description></HediffDef>
</Defs>
