<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <BiomeDef Name="PF_PlanetKindBiomeBase" Abstract="True">
    <workerClass>BiomeWorker_Desert</workerClass>
    <implemented>true</implemented>
    <generatesNaturally>false</generatesNaturally>
    <canBuildBase>true</canBuildBase>
    <canAutoChoose>false</canAutoChoose>
    <allowFarmingCamps>false</allowFarmingCamps>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <settlementSelectionWeight>0</settlementSelectionWeight>
    <movementDifficulty>2</movementDifficulty>
    <forageability>0</forageability>
    <geyserCountFactor>0</geyserCountFactor>
    <maxFishPopulation>0</maxFishPopulation>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <isExtremeBiome>true</isExtremeBiome>
  </BiomeDef>
  <BiomeDef ParentName="PF_PlanetKindBiomeBase">
    <defName>PF_BarrenRock</defName>
    <label>荒芜岩原</label>
    <description>缺乏植被的裸岩与碎石地表，适用于多种荒芜岩质天体。</description>
    <texture>World/Biomes/ExtremeDesert</texture>
    <inVacuum>true</inVacuum>
    <noAmbientWind>true</noAmbientWind>
    <settleWarning>这里没有可呼吸大气。登陆前请准备密闭生存空间、舱外装备与温度防护。</settleWarning>
    <baseWeatherCommonalities>
      <PF_Vaccum>1</PF_Vaccum>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>PF_MoonDirt</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>
  <BiomeDef ParentName="PF_PlanetKindBiomeBase">
    <defName>PF_BarrenRegolith</defName>
    <label>荒芜尘原</label>
    <description>细碎风化物覆盖的干燥地表，没有自然植物与动物。</description>
    <texture>World/Biomes/Desert</texture>
    <inVacuum>true</inVacuum>
    <noAmbientWind>true</noAmbientWind>
    <settleWarning>这里没有可呼吸大气。登陆前请准备密闭生存空间、舱外装备与温度防护。</settleWarning>
    <baseWeatherCommonalities>
      <PF_Vaccum>1</PF_Vaccum>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>PF_MoonDirt</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>
  <BiomeDef ParentName="PF_PlanetKindBiomeBase">
    <defName>PF_FrozenPlain</defName>
    <label>冰封平原</label>
    <description>长期低温下形成的冰质地表，可与岩石露头共同组成冰封天体。</description>
    <texture>World/Biomes/IceSheetOcean</texture>
    <inVacuum>true</inVacuum>
    <noAmbientWind>true</noAmbientWind>
    <settleWarning>这里没有可呼吸大气。登陆前请准备密闭生存空间、舱外装备与温度防护。</settleWarning>
    <baseWeatherCommonalities>
      <PF_Vaccum>1</PF_Vaccum>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>Ice</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>
  <BiomeDef ParentName="PF_PlanetKindBiomeBase">
    <defName>PF_GreenhousePlain</defName>
    <label>灼热平原</label>
    <description>浓厚大气下的灼热、干燥地表，缺乏自然生态。高压与气体毒性需要额外环境能力。</description>
    <texture>World/Biomes/ExtremeDesert</texture>
    <inVacuum>false</inVacuum>
    <noAmbientWind>false</noAmbientWind>
    <settleWarning>地表温度极高。普通殖民者和设备无法安全暴露在户外。</settleWarning>
    <baseWeatherCommonalities>
      <Clear>1</Clear>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>Sand</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>
</Defs>
