<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ════════════════════════════════════════════════════════════════════
       M1 第一刀 · 零件目录最小集（2026-10-17）
       纯数据 Def：只被 DesignPartAssembler 读来派生 SpacePart（几何 + 质量）；
       推进仍按 M2 甲 留在地图/实体级，但**推进参数（ve/ṁ/罐容/工质）以本目录为唯一出处**——
       PartPropulsionResolver 先查这里，未收录的条目才回退建筑 ThingDef 的 Comp。
       不是 ThingDef，不进建造菜单、不需要贴图。
       ⚠ **必须带 Class 属性**：RimWorld 的 Def 解析按简单类型名 `assembly.GetType("ShipPartDef")`
       查全局类型，找不到命名空间里的 `PioneerFramework.ShipPartDef` ⇒ 写全名。
       ════════════════════════════════════════════════════════════════════ -->
  <!-- 2026-10-29 用户令"工质罐和引擎都改为圆柱"：thruster / tank / rcs / rcs-tank 一律
       <shape>Cylinder</shape>。口径 = **圆柱轴向 = 体 Z**（= 堆叠轴 = 机头 +Z）：
       直径取 boundsX（圆截面 ⇒ boundsZ 同值），高取堆叠长度。渲染/惯量/碰撞胶囊三处同口径。
       其它类别（stage/reactor/battery/radiator/cargo/weapon/control/payload-bay）保持 Box。 -->
  <ShipPartDef Class="PioneerFramework.ShipPartDef">
    <defName>PF_ShipPart_Thruster_Debug</defName>
    <assemblyCost>
      <Steel>100</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </assemblyCost>
    <!-- 2026-10-26 裁定 A：目录显式热源（30 kW）；装配器写进同一个 EngineComponentData -->
    <heatProductionWatts>30000</heatProductionWatts>
    <!-- 2026-10-27：引擎被动散热 10 kW（用散热器组件承载） -->
    <heatDissipationWatts>10000</heatDissipationWatts>
    <label>调试推进器</label>
    <category>thruster</category>
    <massKg>500</massKg>
    <boundsX>2</boundsX>
    <boundsY>4</boundsY>
    <boundsZ>2</boundsZ>
    <stackLengthMeters>4</stackLengthMeters>
    <shape>Cylinder</shape>
    <armorMaterial>PF_Armor_Steel</armorMaterial>
    <armorThicknessMm>10</armorThicknessMm>
    <exhaustVelocity>3000</exhaustVelocity>
    <massFlowRate>10</massFlowRate>
    <propellantDefName>PF_Propellant_Chemical</propellantDefName>
  </ShipPartDef>

