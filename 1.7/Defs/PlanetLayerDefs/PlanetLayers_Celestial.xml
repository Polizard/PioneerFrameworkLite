<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ════════════════════════════════════════════════════════════════
       天体表面 PlanetLayerDef
       月球兼容名称由自有实例层处理；额外天体共用 PF_CelestialSurface 静态定义。
       ════════════════════════════════════════════════════════════════ -->
  <!-- ── 月球地表 layer ── -->
  <PlanetLayerDef>
    <defName>Moon</defName>
    <label>月球</label>
    <viewGizmoTooltip>查看月球地表。</viewGizmoTooltip>
    <viewGizmoTexPath>UI/Commands/ViewPlanet</viewGizmoTexPath>
    <!-- 物理与生成参数由实例头提供。 -->
    <layerType>PioneerFramework.Celestial.CelestialSurfaceLayer</layerType>
    <tileType>SurfaceTile</tileType>
    <elevationString>{0}m</elevationString>
    <gerundLabel>在月球</gerundLabel>
    <backgroundBiome>PF_MoonBiomeWater</backgroundBiome>
    <worldGenSteps>
      <li>PF_CelestialTiles</li>
    </worldGenSteps>
    <worldDrawLayers>
      <li>WorldDrawLayer_CurrentMapTile</li>
      <li>WorldDrawLayer_SelectedTile</li>
      <li>WorldDrawLayer_MouseTile</li>
      <li>PioneerFramework.WorldDrawLayer_MoonUngeneratedPlanetParts</li>
      <li>WorldDrawLayer_WorldObjects_Expandable</li>
      <li>WorldDrawLayer_WorldObjects_NonExpandable</li>
      <li>WorldDrawLayer_Glow</li>
      <li>WorldDrawLayer_Terrain</li>
      <li>WorldDrawLayer_Clouds</li>
    </worldDrawLayers>
    <worldTabs>
      <li>WITab_Terrain</li>
      <li>WITab_Planet</li>
    </worldTabs>
  </PlanetLayerDef>
</Defs>
