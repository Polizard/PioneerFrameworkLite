<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>PF_Building_Tank_Hydrogen</defName>
    <label>液氢储罐</label>
    <description>储存液氢工质的大型储罐。罐内工质会计入所属飞船的推进剂账户，供引擎消耗。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/FermentingBarrel</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>300</Mass>
      <Beauty>-5</Beauty>
      <WorkToBuild>400</WorkToBuild>
    </statBases>
    <costList>
      <Steel>120</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <comps>
      <li Class="PioneerFramework.CompProperties_PropellantTank">
        <propellantDefName>PF_Propellant_Hydrogen</propellantDefName>
        <capacity>5000</capacity>
      </li>
    </comps>
  </ThingDef>

