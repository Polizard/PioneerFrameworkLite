  <ThingDef ParentName="BuildingBase">
    <defName>PF_Building_Rocket_Basic</defName>
    <label>基础火箭</label>
    <description>PFL 基础不可回收火箭，用于测试地面总装和发射入轨。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/R7_Rocket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(10,10)</drawSize>
      <drawOffset>(0,0,4)</drawOffset>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <WorkToBuild>1000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>200</Steel>
    </costList>
    <dropPodActive>PF_ActivePod_Basic</dropPodActive>
    <dropPodFaller>PF_Skyfaller_Incoming_Basic</dropPodFaller>
    <comps>
      <li Class="CompProperties_Transporter">
        <restEffectiveness>0.8</restEffectiveness>
        <massCapacity>2000</massCapacity>
      </li>
      <li Class="PioneerFramework.GroundAssembly.CompProperties_RocketPocketMap" />
      <li Class="CompProperties_Launchable_TransportPod">
        <activeTransporterDef>PF_ActivePod_Basic</activeTransporterDef>
        <skyfallerLeaving>PF_Skyfaller_Leaving_Basic</skyfallerLeaving>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2202</uiOrder>
    <uiIconScale>0.1</uiIconScale>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>PF_Building_Rocket_Recoverable_Basic</defName>
    <label>基础可回收火箭</label>
    <description>PFL 基础可回收火箭，用于测试发射、第一级回收和重建。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/ZQ_Rocket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(10,10)</drawSize>
      <drawOffset>(0,0,4)</drawOffset>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <costList>
      <Steel>300</Steel>
    </costList>
    <dropPodActive>PF_ActivePod_Basic</dropPodActive>
    <dropPodFaller>PF_Skyfaller_Incoming_Basic</dropPodFaller>
    <comps>
      <li Class="CompProperties_Transporter">
        <restEffectiveness>0.8</restEffectiveness>
        <massCapacity>15000</massCapacity>
      </li>
      <li Class="PioneerFramework.GroundAssembly.CompProperties_RocketPocketMap" />
      <li Class="CompProperties_Launchable_TransportPod">
