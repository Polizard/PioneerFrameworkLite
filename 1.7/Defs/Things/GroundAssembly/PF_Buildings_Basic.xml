  <ThingDef ParentName="BuildingBase">
    <defName>PF_Building_Booster_Returned_Basic</defName>
    <label>基础回收第一级</label>
    <description>回收回来的基础第一级助推器，可运回总装发射台重建。</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/ZQ_Booster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
      <drawOffset>(0,0,2)</drawOffset>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Mass>200</Mass>
      <WorkToBuild>500</WorkToBuild>
    </statBases>
    <costList>
      <Steel>50</Steel>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <minifiedDrawScale>1.5</minifiedDrawScale>
    <thingCategories>
      <li>Buildings</li>
    </thingCategories>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2204</uiOrder>
    <comps>
      <li Class="PioneerFramework.GroundAssembly.CompProperties_ReturnedBooster" />
    </comps>
    <uiIconScale>0.1</uiIconScale>
  </ThingDef>

</Defs>
