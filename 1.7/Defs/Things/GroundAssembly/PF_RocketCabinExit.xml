<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 火箭舱内出口：生成在舱内地图，提供“返回地面”交互。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>PF_Building_Rocket_CabinExit</defName>
    <label>火箭舱门</label>
    <description>连接火箭舱内与地面登船口的舱门。</description>
    <thingClass>PioneerFramework.GroundAssembly.Building_SpacecraftExit</thingClass>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <selectable>true</selectable>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <passability>Standable</passability>
    <building>
      <deconstructible>false</deconstructible>
      <isTargetable>true</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/CaveExit/CaveExit</texPath>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

</Defs>
