<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 发射台常驻脐带塔：航天舱室火箭的唯一登船入口（复用原版 MapPortal）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>PF_Building_Rocket_UmbilicalTower</defName>
    <label>脐带塔</label>
    <description>连接地面发射台与火箭舱内的登船设施。</description>
    <thingClass>PioneerFramework.GroundAssembly.Building_RocketUmbilicalTower</thingClass>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <selectable>true</selectable>
    <canOverlapZones>true</canOverlapZones>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <passability>Standable</passability>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/SpaceLaunchTechnology/LaunchPadS</texPath>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <isTargetable>true</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <portal>
      <pocketMapGenerator>PF_RocketCabinPocket</pocketMapGenerator>
      <exitDef>PF_Building_Rocket_CabinExit</exitDef>
      <pocketMapSize>50</pocketMapSize>
    </portal>
    <comps>
      <li Class="PioneerFramework.GroundAssembly.CompProperties_UmbilicalTower" />
    </comps>
  </ThingDef>

</Defs>
