<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- [V7] 传感器阵列建筑（建筑级 EW，2026-10-01）
       与部件级 PF 传感器组件同量纲（SensorTech 三分量），建筑级大一档。
       贡献随毁损而掉（投影侧按 HitPoints/MaxHitPoints 折算）。 -->
  <ThingDef>
    <defName>PF_Building_SensorArray</defName>
    <label>传感器阵列</label>
    <description>大型被动传感器阵列。其灵敏度计入所属飞船/空间站的侦测技术；受创后效能随之下降。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/FermentingBarrel</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,3)</size>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0.02</Flammability>
      <Mass>800</Mass>
      <Beauty>-8</Beauty>
      <WorkToBuild>900</WorkToBuild>
    </statBases>
    <costList>
      <Steel>250</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <comps>
      <li Class="PioneerFramework.CompProperties_SensorArray">
        <passiveRangeMeters>5000000</passiveRangeMeters>
        <!-- [V3] 记忆时长（s，物理秒轴；2026-10-02 裁定 ②）：接触在最后一次刷新后还能活多久。待定标。 -->
        <memorySeconds>30</memorySeconds>
        <ecmResist>0.8</ecmResist>
        <eccmResist>0.8</eccmResist>
      </li>
    </comps>
  </ThingDef>

</Defs>
