<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>PF_Building_Thruster_Chemical</defName>
    <label>化学推进器</label>
    <description>大推力化学推进器，消耗化学推进剂。推力 F = ve·ṁ。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/SpaceLaunchTechnology/ZQ_Rocket</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>2000</Mass>
      <Beauty>-8</Beauty>
      <WorkToBuild>800</WorkToBuild>
    </statBases>
    <costList>
      <Steel>300</Steel>
    </costList>
    <designationCategory>Power</designationCategory>
    <uiOrder>105</uiOrder>
    <comps>
      <li Class="PioneerFramework.CompProperties_Thruster">
        <propellantDefName>PF_Propellant_Chemical</propellantDefName>
        <exhaustVelocity>3500</exhaustVelocity>
        <massFlowRate>20</massFlowRate>
      </li>
    </comps>
  </ThingDef>

