<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>PF_Building_Shuttle</defName>
    <label>奥德赛穿梭机</label>
    <description>太空⇄空间站的通用运输穿梭机。停泊时作为站内建筑（3x3 着陆台），可装载乘客起飞执行跳帮突击或运输（ShuttleId 贯穿停泊与飞行两态）。飞行中被击毁 = 乘客全灭。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Ship/ShipSensorCluster</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,3)</size>
    <passability>Impassable</passability>
    <!-- 不可通行 + 玩家可建造：官方校验要求实心或显式禁用"可被射击/看穿"警告（1.6 字段名，无 blockCover） -->
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>50000</Mass>
      <Beauty>-10</Beauty>
    </statBases>
    <designationCategory>Power</designationCategory>
    <uiOrder>120</uiOrder>
    <comps>
      <li Class="PioneerFramework.CompProperties_ShuttleDock" />
    </comps>
  </ThingDef>

</Defs>
