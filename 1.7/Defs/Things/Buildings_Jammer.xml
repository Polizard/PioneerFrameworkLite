<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- [E3] 干扰机建筑（建筑级 EW，2026-10-02）
       压制式干扰：抬高**敌方观测方**的探测阈值（按"干扰机→观测方"距离平方反比衰减），
       目标是"看不见/看得糊"，不是"打掉"。
       · 贡献随毁损而掉（投影侧按 HitPoints/MaxHitPoints 折算）；
       · **开不开机是群级开关**（`SpaceEntityGroup.JammingEnabled`）——建筑只给能力；
         开机即暴露（W1：干扰机必须辐射才能干扰，信号抬升 = SignalModel.JamMultiplier）。 -->
  <ThingDef>
    <defName>PF_Building_Jammer</defName>
    <label>干扰机</label>
    <description>大型压制式干扰机。开机后抬高敌方传感器的探测阈值（作用范围随距离衰减），代价是自身信号显著升高、并成为反辐射武器的靶子。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/CommsConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,3)</size>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <Flammability>0.05</Flammability>
      <Mass>700</Mass>
      <Beauty>-10</Beauty>
      <WorkToBuild>1100</WorkToBuild>
    </statBases>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <designationCategory>Power</designationCategory>
    <comps>
      <li Class="PioneerFramework.CompProperties_Jammer">
        <!-- 干扰效力（无量纲）：2.0 = 在 DetectionCore.JamRefMeters（1,000 km）处把有效信号砍到 1/3。待定标。 -->
        <jamStrength>2.0</jamStrength>
      </li>
    </comps>
  </ThingDef>

</Defs>
