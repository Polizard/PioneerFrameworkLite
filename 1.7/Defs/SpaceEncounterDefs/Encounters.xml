    <width>40</width><height>40</height><dryMass>35000</dryMass>
    <role>Gunship</role><ammunition>24</ammunition>
    <buildings>
      <li><defName>PF_Building_Thruster_Chemical</defName><cell>(12,0,6)</cell></li>
      <li><defName>PF_Building_Thruster_Chemical</defName><cell>(26,0,6)</cell></li>
      <li><defName>PF_Building_Thruster_Rcs</defName><cell>(19,0,8)</cell></li>
      <li><defName>PF_Building_Tank_Chemical</defName><cell>(14,0,10)</cell></li>
      <li><defName>PF_Building_Tank_Hydrogen</defName><cell>(24,0,10)</cell></li>
      <li><defName>PF_Building_Turret_Cannon</defName><cell>(12,0,20)</cell></li>
      <li><defName>PF_Building_Turret_Cannon</defName><cell>(27,0,20)</cell></li>
      <li><defName>PF_Building_SensorArray</defName><cell>(12,0,28)</cell></li>
