  <PioneerFramework.SpaceAI.SpaceShipTemplateDef>
    <defName>PF_AI_ElectronicWarfareShip</defName>
    <label>电子战支援舰</label>
    <description>提供主动搜索、压制干扰和诱饵掩护的支援舰。</description>
    <width>40</width><height>40</height><dryMass>32000</dryMass>
    <role>ElectronicWarfare</role><ammunition>12</ammunition>
    <buildings>
      <li><defName>PF_Building_Thruster_Chemical</defName><cell>(12,0,6)</cell></li>
      <li><defName>PF_Building_Thruster_Rcs</defName><cell>(26,0,6)</cell></li>
