  <PioneerFramework.SpaceAI.SpaceEncounterDef>
    <defName>PF_Encounter_RaidingFleet</defName>
    <label>太空袭击编队</label>
    <description>由炮战、导弹与电子战舰组成的小型敌方编队。</description>
    <minShips>3</minShips><maxShips>6</maxShips>
    <spawnDistance>30000</spawnDistance><shipSeparation>7500</shipSeparation>
    <withdrawalDistance>150000</withdrawalDistance><preparationSeconds>30</preparationSeconds>
    <searchAbandonSeconds>180</searchAbandonSeconds><withdrawalSeconds>120</withdrawalSeconds>
    <templates><li>PF_AI_Gunship</li><li>PF_AI_MissileShip</li><li>PF_AI_ElectronicWarfareShip</li></templates>
  </PioneerFramework.SpaceAI.SpaceEncounterDef>
  <IncidentDef>
    <defName>PF_SpaceFleetEncounter</defName>
    <label>太空袭击</label>
    <category>ThreatBig</category>
    <workerClass>PioneerFramework.SpaceAI.IncidentWorker_SpaceEncounter</workerClass>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <baseChance>0.4</baseChance>
    <minRefireDays>15</minRefireDays>
  </IncidentDef>
</Defs>
