      <li><defName>PF_Building_SensorArray</defName><cell>(12,0,28)</cell></li>
      <li><defName>PF_Building_ActiveRadar</defName><cell>(26,0,28)</cell></li>
      <li><defName>PF_Building_DecoyEmitter</defName><cell>(19,0,25)</cell></li>
      <li><defName>PF_Building_SteeringConsole</defName><cell>(19,0,31)</cell></li>
