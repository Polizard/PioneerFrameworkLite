<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Reusable kind presets. They are not added to PF_DefaultCelestialSystem. Motion is a representative circular orbit; override motion and bind frameOrigin/primaryLight for each actual instance. See Source/PioneerFramework/Celestial/API/PlanetKinds.md. -->
  <PioneerFramework.CelestialBodyDef Name="PF_BarrenPlanetBase">
    <defName>PF_BarrenPlanet</defName>
    <label>荒芜行星</label>
    <description>岩石、碎屑与风化物构成的荒芜天体。可覆盖水星、火星和月球一类地表。此预设采用真空环境；有大气的实例需同步覆盖大气与地表环境。</description>
    <category>Barren</category>
    <tags>
      <li>PlanetKind</li>
      <li>Barren</li>
      <li>Rocky</li>
      <li>Airless</li>
      <li>NoNativeEcology</li>
    </tags>
    <comps>
      <li Class="PioneerFramework.Celestial.CompProperties_SphericalBody">
        <key>shape</key>
        <radiusMeters>
          <value>2500000</value>
        </radiusMeters>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExternalPhysicsBinding">
        <key>motion</key>
        <providerId>PFL.ExistingEphemeris</providerId>
        <gravitationalParameter>
          <value>4e12</value>
        </gravitationalParameter>
        <motion>
          <orbitRadiusMeters>120000000</orbitRadiusMeters>
          <orbitPeriodSeconds>58400</orbitPeriodSeconds>
          <orbitPhaseRadians>0</orbitPhaseRadians>
          <bodyType>Planet</bodyType>
          <frameOriginReference>frameOrigin</frameOriginReference>
          <rotation>
            <periodSeconds>60000</periodSeconds>
          </rotation>
        </motion>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_Surface">
        <key>surface</key>
        <generationMode>OnDemand</generationMode>
        <subdivisions>
          <value>5</value>
        </subdivisions>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_BiomeGeneration">
        <key>biomes</key>
        <profile>PF_BarrenBiomes</profile>
        <useEnvironmentClimate>true</useEnvironmentClimate>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_MapGeneration">
        <key>maps</key>
        <profile>PF_BarrenMaps</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExistingEnvironment">
        <key>environment</key>
        <profile>PF_BarrenEnvironment</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_CelestialVisual">
        <key>visual</key>
        <profile>PF_BarrenSurfaceVisual</profile>
      </li>
    </comps>
  </PioneerFramework.CelestialBodyDef>
