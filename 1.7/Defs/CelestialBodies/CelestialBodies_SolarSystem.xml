<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <!-- 2026-11-11：四个太阳系天体改用可读 <motion> 授权（existing.circular.v2），
       与 CelestialBodies_PlanetKinds.xml 同一写法；数值逐项等于旧 v1 载荷（半径/周期/相位/日长）。
       v1 载荷工具（tools/celestial_payload.py）保留给存档夹具与旧存档兼容解析。 -->
  <PioneerFramework.CelestialBodyDef>
    <defName>Sun</defName>
    <label>燧阳</label>
    <category>Star</category>
    <comps>
      <li Class="PioneerFramework.Celestial.CompProperties_SphericalBody">
        <key>shape</key>
        <radiusMeters>
          <value>139140000</value>
        </radiusMeters>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExternalPhysicsBinding">
        <key>motion</key>
        <providerId>PFL.ExistingEphemeris</providerId>
        <gravitationalParameter>
          <value>2.4369393583e19</value>
        </gravitationalParameter>
        <motion>
          <orbitRadiusMeters>0</orbitRadiusMeters>
          <orbitPeriodSeconds>0</orbitPeriodSeconds>
          <orbitPhaseRadians>0</orbitPhaseRadians>
          <bodyType>Star</bodyType>
          <frameOriginReference>frameOrigin</frameOriginReference>
          <rotation>
            <periodSeconds>60000</periodSeconds>
          </rotation>
        </motion>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_LightSource">
        <key>light</key>
        <intensity><value>0.25</value></intensity>
        <red><value>1</value></red>
        <green><value>0.706</value></green>
        <blue><value>0.459</value></blue>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_CelestialVisual">
        <key>visual</key>
        <profile>PF_StellarVisual</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_StellarVisual">
        <key>stellar</key>
        <profile>PF_StellarVisual</profile>
      </li>
    </comps>
  </PioneerFramework.CelestialBodyDef>
  <PioneerFramework.CelestialBodyDef>
    <defName>Earth</defName>
    <label>Rimata</label>
    <category>Planet</category>
    <comps>
      <li Class="PioneerFramework.Celestial.CompProperties_SphericalBody">
        <key>shape</key>
        <radiusMeters>
          <value>5000000</value>
        </radiusMeters>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExternalPhysicsBinding">
        <key>motion</key>
        <providerId>PFL.ExistingEphemeris</providerId>
        <gravitationalParameter>
          <value>2.0e14</value>
        </gravitationalParameter>
        <motion>
          <orbitRadiusMeters>20000000000</orbitRadiusMeters>
          <orbitPeriodSeconds>3600000</orbitPeriodSeconds>
          <orbitPhaseRadians>0</orbitPhaseRadians>
          <bodyType>Planet</bodyType>
          <frameOriginReference>frameOrigin</frameOriginReference>
          <rotation>
            <periodSeconds>60000</periodSeconds>
          </rotation>
        </motion>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_Surface">
        <key>surface</key>
        <generationMode>OnDemand</generationMode>
        <subdivisions>
          <value>10</value>
        </subdivisions>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_BiomeGeneration">
        <key>biomes</key>
        <profile>PF_EarthBiomes</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_MapGeneration">
        <key>maps</key>
        <profile>PF_EarthMaps</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExistingEnvironment">
        <key>environment</key>
        <profile>PF_EarthEnvironment</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_Atmosphere">
        <key>air</key>
        <rho0>
          <value>1.2</value>
        </rho0>
        <scaleHeight>
          <value>8000</value>
        </scaleHeight>
        <topAltitude>
          <value>100000</value>
        </topAltitude>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_CelestialVisual">
        <key>visual</key>
        <profile>PF_EarthSurfaceVisual</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_AtmosphereVisual">
        <key>atmosphereVisual</key>
        <profile>PF_EarthAtmosphereVisual</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_CloudsVisual">
        <key>clouds</key>
        <profile>PF_EarthCloudsVisual</profile>
      </li>
    </comps>
  </PioneerFramework.CelestialBodyDef>
  <PioneerFramework.CelestialBodyDef>
    <defName>Moon</defName>
    <label>Wardon</label>
    <category>Moon</category>
    <comps>
      <li Class="PioneerFramework.Celestial.CompProperties_SphericalBody">
        <key>shape</key>
        <radiusMeters>
          <value>1500000</value>
        </radiusMeters>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExternalPhysicsBinding">
        <key>motion</key>
        <providerId>PFL.ExistingEphemeris</providerId>
        <gravitationalParameter>
          <value>5.0e12</value>
        </gravitationalParameter>
        <motion>
          <orbitRadiusMeters>80000000</orbitRadiusMeters>
          <orbitPeriodSeconds>317900</orbitPeriodSeconds>
          <orbitPhaseRadians>1.5</orbitPhaseRadians>
          <bodyType>Moon</bodyType>
          <frameOriginReference>frameOrigin</frameOriginReference>
          <rotation>
            <!-- 2026-11-11：由「日长=公转周期」的数值近似改为真潮汐锁定（v2 的同步目标）。
                 frameOrigin 在卫星条目里是 Parent 作用域 ⇒ 解析到母星 Earth。 -->
            <synchronousTargetReference>frameOrigin</synchronousTargetReference>
          </rotation>
        </motion>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_Surface">
        <key>surface</key>
        <generationMode>Creation</generationMode>
        <subdivisions>
          <value>5</value>
        </subdivisions>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_BiomeGeneration">
        <key>biomes</key>
        <profile>PF_MoonBiomes</profile>
        <useEnvironmentClimate>true</useEnvironmentClimate>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_MapGeneration">
        <key>maps</key>
        <profile>PF_MoonMaps</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExistingEnvironment">
        <key>environment</key>
        <profile>PF_MoonEnvironment</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_CelestialVisual">
        <key>visual</key>
        <profile>PF_MoonSurfaceVisual</profile>
      </li>
    </comps>
  </PioneerFramework.CelestialBodyDef>
  <PioneerFramework.CelestialBodyDef>
    <defName>ZheSha</defName>
    <label>赭砂</label>
    <category>Planet</category>
    <comps>
      <li Class="PioneerFramework.Celestial.CompProperties_SphericalBody">
        <key>shape</key>
        <radiusMeters>
          <value>5300000</value>
        </radiusMeters>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_ExternalPhysicsBinding">
        <key>motion</key>
        <providerId>PFL.ExistingEphemeris</providerId>
        <gravitationalParameter>
          <value>2.4e14</value>
        </gravitationalParameter>
        <motion>
          <orbitRadiusMeters>13333333333.333334</orbitRadiusMeters>
          <orbitPeriodSeconds>1959591.794</orbitPeriodSeconds>
          <orbitPhaseRadians>4.596</orbitPhaseRadians>
          <bodyType>Planet</bodyType>
          <frameOriginReference>frameOrigin</frameOriginReference>
          <rotation>
            <periodSeconds>60000</periodSeconds>
          </rotation>
        </motion>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_Surface">
        <key>surface</key>
        <generationMode>Creation</generationMode>
        <subdivisions>
          <value>5</value>
        </subdivisions>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_BiomeGeneration">
        <key>biomes</key>
        <profile>PF_MoonBiomes</profile>
      </li>
      <li Class="PioneerFramework.Celestial.CompProperties_CelestialVisual">
        <key>visual</key>
        <profile>PF_ZheShaSurfaceVisual</profile>
      </li>
    </comps>
  </PioneerFramework.CelestialBodyDef>
</Defs>
