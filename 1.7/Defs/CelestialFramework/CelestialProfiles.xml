<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PioneerFramework.Celestial.CelestialBiomeProfileDef>
    <defName>PF_EarthBiomes</defName>
    <label>原版地表生成</label>
    <mode>VanillaSurface</mode>
    <worldGenSteps>
      <li>Terrain</li><li>Lakes</li><li>Rivers</li><li>Mutators</li>
      <li MayRequire="Ludeon.RimWorld.Odyssey">Landmarks</li>
      <li>AncientSites</li>
      <li>AncientRoads</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Pollution</li>
    </worldGenSteps>
    <rootOnlySteps><li>Factions</li><li>Roads</li><li>Features</li></rootOnlySteps>
  </PioneerFramework.Celestial.CelestialBiomeProfileDef>
  <PioneerFramework.Celestial.CelestialBiomeProfileDef>
    <defName>PF_MoonBiomes</defName>
    <label>月球纬度带</label>
    <mode>LatitudeBands</mode>
    <polarBiome>PF_MoonBiomeWater</polarBiome>
    <primaryBiome>PF_MoonBiomeBasalt</primaryBiome>
    <secondaryBiome>PF_MoonBiomeRegolith</secondaryBiome>
    <polarLatitude>75</polarLatitude><secondaryChance>0.5</secondaryChance>
    <polarHilliness>Flat</polarHilliness><primaryHilliness>SmallHills</primaryHilliness><secondaryHilliness>Flat</secondaryHilliness>
    <temperature>0</temperature><rainfall>0</rainfall><swampiness>0</swampiness>
    <rootOnlySteps><li>Factions</li><li>Roads</li><li>Features</li></rootOnlySteps>
  </PioneerFramework.Celestial.CelestialBiomeProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef>
    <defName>PF_EarthMaps</defName><label>原版殖民地地图</label>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef>
    <defName>PF_MoonMaps</defName><label>月球殖民地地图</label>
    <skipStepNames>
      <li>RockChunks</li><li>Snow</li><li>ScatterRuinsSimple</li><li>ScatterShrines</li>
      <li>ScatterRoadDebris</li><li>ScatterCaveDebris</li><li>MechanoidRemains</li><li>VoidMonolith</li>
    </skipStepNames>
    <skipStepPrefixes><li>Ancient</li></skipStepPrefixes>
    <skipStepTypes><li>RimWorld.GenStep_RockChunks</li><li>RimWorld.GenStep_ScatterRuinsSimple</li><li>RimWorld.GenStep_ScatterShrines</li></skipStepTypes>
    <replaceTerrains><li>Gravel</li></replaceTerrains><replacementTerrain>PF_MoonDirt</replacementTerrain>
    <biomeRules>
      <li><biome>PF_MoonBiomeRegolith</biome><skipStepNames><li>RocksFromGrid</li><li>RocksFromGrid_NoMinerals</li></skipStepNames><skipStepTypes><li>RimWorld.GenStep_RocksFromGrid</li></skipStepTypes><replaceRockTerrains>true</replaceRockTerrains></li>
      <li><biome>PF_MoonBiomeWater</biome><skipStepNames><li>RocksFromGrid</li><li>RocksFromGrid_NoMinerals</li></skipStepNames><skipStepTypes><li>RimWorld.GenStep_RocksFromGrid</li></skipStepTypes><replaceRockTerrains>true</replaceRockTerrains></li>
    </biomeRules>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
  <PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
    <defName>PF_EarthEnvironment</defName><label>地球现有环境</label>
    <dayLengthTicks>60000</dayLengthTicks><primaryLightReference>primaryLight</primaryLightReference>
  </PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
  <PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
    <defName>PF_MoonEnvironment</defName><label>月球现有环境</label>
    <dayLengthTicks>317900</dayLengthTicks><primaryLightReference>primaryLight</primaryLightReference>
    <vacuumBiomes><li>PF_MoonBiomeWater</li><li>PF_MoonBiomeBasalt</li><li>PF_MoonBiomeRegolith</li></vacuumBiomes>
  </PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
</Defs>
