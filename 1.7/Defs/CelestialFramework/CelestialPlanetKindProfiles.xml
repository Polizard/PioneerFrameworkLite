  <PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
    <defName>PF_TemperateEnvironment</defName>
    <label>温带行星环境</label>
    <dayLengthTicks>60000</dayLengthTicks>
    <primaryLightReference>primaryLight</primaryLightReference>
    <climate>
      <meanTemperatureCelsius>20</meanTemperatureCelsius>
      <diurnalAmplitudeCelsius>12</diurnalAmplitudeCelsius>
      <seasonalAmplitudeCelsius>8</seasonalAmplitudeCelsius>
      <thermalResponseSeconds>600</thermalResponseSeconds>
      <rainfallMillimeters>1000</rainfallMillimeters>
      <humidity>0.6</humidity>
    </climate>
    <exposure>
      <toxicityPerDay>0</toxicityPerDay>
      <gravityStats>true</gravityStats>
    </exposure>
  </PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
  <PioneerFramework.Celestial.CelestialBiomeProfileDef>
    <defName>PF_TemperateBiomes</defName>
    <label>温带行星地表</label>
    <mode>Parameterized</mode>
    <worldGenSteps>
      <li>Lakes</li>
      <li>Rivers</li>
      <li>Mutators</li>
      <li MayRequire="Ludeon.RimWorld.Odyssey">Landmarks</li>
    </worldGenSteps>
    <terrain>
      <oceanCoverage>
        <min>0.45</min>
        <max>0.7</max>
      </oceanCoverage>
      <allowRivers>true</allowRivers>
      <allowLakes>true</allowLakes>
      <parameters>
        <li>
          <key>roughness</key>
          <value>
            <min>0.2</min>
            <max>0.6</max>
          </value>
        </li>
      </parameters>
      <biomeRules>
        <li>
          <key>cold</key>
          <biome>Tundra</biome>
          <maximumTemperatureCelsius>0</maximumTemperatureCelsius>
        </li>
        <li>
          <key>dry</key>
          <biome>Desert</biome>
          <maximumRainfallMillimeters>500</maximumRainfallMillimeters>
        </li>
        <li>
          <key>fallback</key>
          <biome>TemperateForest</biome>
          <fallback>true</fallback>
        </li>
      </biomeRules>
    </terrain>
  </PioneerFramework.Celestial.CelestialBiomeProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef>
    <defName>PF_TemperateMaps</defName>
    <label>温带行星地图</label>
    <localRecipe>PF_LocalMapNative</localRecipe>
    <useDiversityAsInitialInputs>true</useDiversityAsInitialInputs>
    <diversity>
      <parameters>
        <li>
          <key>mineralAbundance</key>
          <value>
            <min>0.5</min>
            <max>1.5</max>
          </value>
        </li>
      </parameters>
      <plantDensity>1</plantDensity>
      <animalDensity>1</animalDensity>
      <geologyVariation>0.3</geologyVariation>
      <weather>
        <li>
          <def>Clear</def>
          <weight>3</weight>
        </li>
        <li>
          <def>Rain</def>
          <weight>1</weight>
        </li>
      </weather>
    </diversity>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
</Defs>
