<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PioneerFramework.Celestial.CelestialBiomeProfileDef>
    <defName>PF_BarrenBiomes</defName>
    <label>荒芜地表生成</label>
    <mode>LatitudeBands</mode>
    <polarBiome>PF_FrozenPlain</polarBiome>
    <primaryBiome>PF_BarrenRock</primaryBiome>
    <secondaryBiome>PF_BarrenRegolith</secondaryBiome>
    <polarLatitude>75</polarLatitude>
    <secondaryChance>0.45</secondaryChance>
    <polarHilliness>Flat</polarHilliness>
    <primaryHilliness>SmallHills</primaryHilliness>
    <secondaryHilliness>Flat</secondaryHilliness>
    <temperature>-30</temperature>
    <rainfall>0</rainfall>
    <swampiness>0</swampiness>
    <rootOnlySteps>
      <li>Factions</li>
      <li>Roads</li>
      <li>Features</li>
    </rootOnlySteps>
  </PioneerFramework.Celestial.CelestialBiomeProfileDef>
  <PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
    <defName>PF_BarrenEnvironment</defName>
    <label>荒芜环境</label>
    <dayLengthTicks>60000</dayLengthTicks>
    <primaryLightReference>primaryLight</primaryLightReference>
    <vacuumBiomes>
      <li>PF_FrozenPlain</li>
      <li>PF_BarrenRock</li>
      <li>PF_BarrenRegolith</li>
    </vacuumBiomes>
  </PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
  <PioneerFramework.Celestial.CelestialBiomeProfileDef>
    <defName>PF_FrozenBiomes</defName>
    <label>冰封地表生成</label>
    <mode>LatitudeBands</mode>
    <polarBiome>PF_FrozenPlain</polarBiome>
    <primaryBiome>PF_FrozenPlain</primaryBiome>
    <secondaryBiome>PF_BarrenRock</secondaryBiome>
    <polarLatitude>75</polarLatitude>
    <secondaryChance>0.2</secondaryChance>
    <polarHilliness>Flat</polarHilliness>
    <primaryHilliness>SmallHills</primaryHilliness>
    <secondaryHilliness>Flat</secondaryHilliness>
    <temperature>-160</temperature>
    <rainfall>0</rainfall>
    <swampiness>0</swampiness>
    <rootOnlySteps>
      <li>Factions</li>
      <li>Roads</li>
      <li>Features</li>
    </rootOnlySteps>
  </PioneerFramework.Celestial.CelestialBiomeProfileDef>
  <PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
    <defName>PF_FrozenEnvironment</defName>
    <label>冰封环境</label>
    <dayLengthTicks>60000</dayLengthTicks>
    <primaryLightReference>primaryLight</primaryLightReference>
    <vacuumBiomes>
      <li>PF_FrozenPlain</li>
      <li>PF_BarrenRock</li>
    </vacuumBiomes>
  </PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
  <PioneerFramework.Celestial.CelestialBiomeProfileDef>
    <defName>PF_GreenhouseBiomes</defName>
    <label>温室地表生成</label>
    <mode>LatitudeBands</mode>
    <polarBiome>PF_GreenhousePlain</polarBiome>
    <primaryBiome>PF_GreenhousePlain</primaryBiome>
    <secondaryBiome>PF_GreenhousePlain</secondaryBiome>
    <polarLatitude>75</polarLatitude>
    <secondaryChance>0</secondaryChance>
    <polarHilliness>Flat</polarHilliness>
    <primaryHilliness>SmallHills</primaryHilliness>
    <secondaryHilliness>Flat</secondaryHilliness>
    <temperature>460</temperature>
    <rainfall>0</rainfall>
    <swampiness>0</swampiness>
    <rootOnlySteps>
      <li>Factions</li>
      <li>Roads</li>
      <li>Features</li>
    </rootOnlySteps>
  </PioneerFramework.Celestial.CelestialBiomeProfileDef>
  <PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
    <defName>PF_GreenhouseEnvironment</defName>
    <label>温室环境</label>
    <dayLengthTicks>1200000</dayLengthTicks>
    <primaryLightReference>primaryLight</primaryLightReference>
  </PioneerFramework.Celestial.CelestialEnvironmentProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef Name="PF_PlanetKindDryMapBase" Abstract="True">
    <skipStepNames>
      <li>Plants</li>
      <li>Animals</li>
      <li>WildPlantSpawner</li>
      <li>WildAnimalSpawner</li>
      <li>River</li>
      <li>Lakes</li>
      <li>Snow</li>
      <li>RockChunks</li>
      <li>ScatterRuinsSimple</li>
      <li>ScatterShrines</li>
      <li>ScatterRoadDebris</li>
      <li>ScatterCaveDebris</li>
      <li>MechanoidRemains</li>
      <li>VoidMonolith</li>
    </skipStepNames>
    <skipStepPrefixes>
      <li>Ancient</li>
    </skipStepPrefixes>
    <skipStepTypes>
      <li>RimWorld.GenStep_RockChunks</li>
      <li>RimWorld.GenStep_ScatterRuinsSimple</li>
      <li>RimWorld.GenStep_ScatterShrines</li>
    </skipStepTypes>
    <replaceTerrains>
      <li>Soil</li>
      <li>SoilRich</li>
      <li>Gravel</li>
      <li>Sand</li>
    </replaceTerrains>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef ParentName="PF_PlanetKindDryMapBase">
    <defName>PF_BarrenMaps</defName>
    <label>荒芜殖民地地图</label>
    <replacementTerrain>PF_MoonDirt</replacementTerrain>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef ParentName="PF_PlanetKindDryMapBase">
    <defName>PF_FrozenMaps</defName>
    <label>冰封殖民地地图</label>
    <replacementTerrain>Ice</replacementTerrain>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
  <PioneerFramework.Celestial.CelestialMapProfileDef ParentName="PF_PlanetKindDryMapBase">
    <defName>PF_GreenhouseMaps</defName>
    <label>温室殖民地地图</label>
    <replacementTerrain>Sand</replacementTerrain>
  </PioneerFramework.Celestial.CelestialMapProfileDef>
</Defs>
